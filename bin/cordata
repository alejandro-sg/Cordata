#!/usr/bin/env bash
# Cordata CLI
#
# Interactive mode (default):
#   cordata                             # Launch interactive TUI session
#   cordata "what is this project"      # Launch interactive TUI with initial query
#
# Batch autonomous commands:
#   cordata run "<goal>"                # Autonomous multi-worker coding run
#   cordata status                      # Worker pool headroom & recent runs
#   cordata show <run_id>               # Inspect plan, history, and audit
#   cordata resume <run_id>             # Continue paused batch run
#   cordata doctor                      # Is everything in place? One screen, fixes included
#
# Everything here is a Rust binary under tui/target/{release,debug}; build them with `make tui-build`.

set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
BIN_DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
REPO_ROOT="$( cd -P "$BIN_DIR/.." >/dev/null 2>&1 && pwd )"

# CORDATA_HOME holds Cordata's state, settings and your own (unconfined) hooks. A value that is relative, or that lies
# inside the repository you are in, is one the repository could have chosen (a direnv .envrc, say), so it is ignored.
if [[ -n "${CORDATA_HOME:-}" ]]; then
  repo="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"
  # Resolved like the repository path (symlinks such as /var -> /private/var); a folder not made yet by its parent.
  wanted="$( (cd "$CORDATA_HOME" 2>/dev/null && pwd -P) || echo "$( (cd "$(dirname "$CORDATA_HOME")" 2>/dev/null && pwd -P) || dirname "$CORDATA_HOME")/$(basename "$CORDATA_HOME")")"
  if [[ "$CORDATA_HOME" != /* ]] || { [[ "$repo" != "${HOME:-}" ]] && [[ "$wanted/" == "$repo/"* ]]; }; then
    echo "cordata: ignoring CORDATA_HOME=$CORDATA_HOME (relative, or inside this repository); using ~/.cordata" >&2
    unset CORDATA_HOME
  fi
fi

# The newest built binary of this name: release, else debug.
built() {
  for kind in release debug; do
    local bin="$REPO_ROOT/tui/target/$kind/$1"
    [[ -x "$bin" ]] && { echo "$bin"; return 0; }
  done
  echo "Error: $1 is not built. Run: make tui-build (in $REPO_ROOT)" >&2
  return 1
}

if [[ "$#" -eq 1 && ("$1" == "-h" || "$1" == "--help") ]]; then
  cat << 'HELP'
Cordata — AI Coding Assistant & Autonomous Orchestrator

  cordata [PROMPT]                 Launch interactive TUI (optionally with initial query)
  cordata run "<goal>" [OPTIONS]   Run an orchestrated coding task across CLI workers
  cordata status                   Inspect worker headroom, recent runs and handoffs
  cordata show RUN_ID              Show one run's plan, history, and audit
  cordata resume RUN_ID            Continue a paused batch run
  cordata evolve [TARGET] [OPTS]   Recursive self-improvement cycle across Iron Gates
  cordata floorplan [OPTIONS]      Architectural map & active-work visualizer (--html to open)
  cordata doctor                   Check the CLIs, providers and settings Cordata leans on
  cordata app [OPTIONS]            Launch native desktop application (GPUI Canvas)
  cordata tui [OPTIONS]            The terminal client with its own options

Options:
  --cwd DIR                        Target project directory (default: current directory)
  -h, --help                       Show this help message
HELP
  exit 0
fi

case "${1:-}" in
  doctor) bin="$(built cordata-doctor)"; shift; exec "$bin" "$@" ;;
  floorplan) bin="$(built cordata-floorplan)"; shift; exec "$bin" "$@" ;;
  run|status|show|resume|evolve) exec "$(built cordata-run)" "$@" ;;
  app|gui)
    shift || true
    if [[ -d "$HOME/Applications/Cordata.app" ]]; then
      open -a "$HOME/Applications/Cordata.app" --args "$@"
    elif [[ -x "$REPO_ROOT/app/target/release/cordata-app" ]]; then
      exec "$REPO_ROOT/app/target/release/cordata-app" "$@"
    else
      open -a "Cordata" 2>/dev/null || (cd "$REPO_ROOT/app" && cargo run --release -q -p cordata-app -- "$@")
    fi
    exit 0
    ;;
  tui) shift; exec "$(built acp-tui)" "$@" ;;
  *) exec "$(built acp-tui)" "$@" ;;
esac
