backend/.venv/
backend/**/__pycache__/
backend/.env
# Credentials, wherever they end up: any .env (the *.example templates are kept), keys, certificates, daemon tokens.
.env
.env.*
!.env.example
!*.env.example
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
*.pem
*.p12
*.pfx
*.key
*.keystore
id_rsa*
id_ed25519*
daemon.json
frontend/node_modules/
frontend/.next/
frontend/.env.local

# Runtime/local state, not source — regenerates or accumulates per machine.
backend/sessions/
backend/workspace/
backend/repl_state/
# The trace corpus (trace_store.py): per-checkout, accumulated, and it records
# prompts, tool inputs and command output, so it must not land in a clone.
backend/memory.lance/
# The knowledge graph (kg/): same reasoning, and it names the files a checkout
# touched and the errors it hit, which is not something to publish by accident.
backend/memory.kg/

# MCP server config — can carry secrets in a server's own env/headers
# fields (mcp_manager.py), same reasoning backend/.env is gitignored for.
backend/mcp_servers.json
frontend/tsconfig.tsbuildinfo
.memsearch/
**/.DS_Store

# scripts/dev-*.sh PID/log files — see scripts/README.md.
.dev/

# Claude Code's own per-checkout local state — personal settings/permissions,
# never something a clone should inherit from whoever committed it.
.claude/settings.local.json

# Rust ACP TUI build output
tui/target/

# Rust Lab build output (harness-lab / harness-observer)
lab/target/

# Rust native app build output
app/target/
app/spike/target/
**/target/

# Shadow-mode triage log (laya_triage.py) — holds user prompts, local only.
backend/laya_triage.jsonl

# Per-machine agent settings and instructions (backend/settings_store.py,
# docs/settings.md) — never something a clone should inherit.
.cordata/settings.local.json
CORDATA.local.md

# Per-machine suite timings run_tests.py schedules by (longest first).
backend/.test-durations.json
