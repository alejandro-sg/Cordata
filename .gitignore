# Credentials, wherever they end up: any .env (the *.example templates are kept), keys and certificates.
.env
.env.*
!.env.example
!*.env.example
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
*.pem
*.p12
*.pfx
*.key
*.keystore
id_rsa*
id_ed25519*

# Build output.
**/target/

# Per-machine state and settings, never something a clone should inherit.
.claude/settings.local.json
.claude/worktrees/
.cordata/settings.local.json
CORDATA.local.md
**/.DS_Store
.dev/
.memsearch/
