# Points at your local oMLX server by default — no key needed.
OMLX_BASE_URL=http://127.0.0.1:8000/v1
OMLX_MODEL_ID=Ternary-Bonsai-27B-mlx-2bit

# Qdrant (agent_memory tool). Defaults to a local container; point at a
# LAN-hosted instance once you're offloading the DB. 127.0.0.1, not
# "localhost" — see settings.py's own comment on why that matters.
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333

# Cloud model instead of local oMLX (provider_settings.py): "anthropic" or
# "openai_compatible" (e.g. Ollama Cloud: base URL https://ollama.com/v1).
# MODEL_PROVIDER=openai_compatible
# CLOUD_OPENAI_BASE_URL=https://ollama.com/v1
# CLOUD_OPENAI_MODEL_ID=gpt-oss:20b
#
# API KEYS GO IN YOUR SHELL, NOT IN THIS FILE:
#     export OLLAMA_API_KEY=...          # (or CLOUD_OPENAI_API_KEY / ANTHROPIC_API_KEY)
# This file sits on disk where the agent's own file_read/shell tools can open
# it; an exported variable is read once at startup, removed from the process
# environment, and masked in every tool result (see secret_guard.py and
# THREAT_MODEL.md, "Provider API keys"). The backend warns at startup if it
# finds a key here.

# Shared secret sandbox_functions_api.py requires on every /sandbox/* and
# /games/* request — main.py binds to 0.0.0.0, so without one, anything on
# your LAN could call runSnippet (arbitrary Python) directly, skipping the
# frontend's approval card entirely. Left unset here on purpose: this
# backend auto-generates a fresh one every process start when it's not
# configured, and the frontend fetches that value itself from this same
# machine (GET /sandbox/_local-token, localhost-only) — a fresh checkout
# still runs with no extra config, but is never actually open. Set this
# explicitly (matching frontend/.env.local's SANDBOX_API_TOKEN) once this
# backend is reachable from a *different* machine than the frontend's own —
# the auto-generated path can't cross that hop on its own, by design.
# SANDBOX_API_TOKEN=

# Extra CORS origins for the AG-UI frontend, if you host it somewhere other
# than http://localhost:3000 (always allowed). Comma-separated.
# EXTRA_CORS_ORIGINS=https://agent.example.com

# Laya triage (laya_triage.py, docs/laya-triage.md): a fast local classifier
# triages each user turn. "route" (default): above a confidence gate, one
# advisory routing hint is added to the orchestrator's system prompt for that
# turn only; Laya's complexity estimate picks a default model tier for
# sub-agents. "shadow": log only. "off": nothing, and Laya isn't loaded for it.
# Either active mode logs user prompts to LAYA_TRIAGE_LOG (default
# backend/laya_triage.jsonl, gitignored); read it with `_laya_triage_report.py`.
# LAYA_TRIAGE_MODE=route
# LAYA_TRIAGE_THRESHOLD=0.85
# LAYA_TRIAGE_TIMEOUT=2.0
# LAYA_TRIAGE_LOG=
# Off by default: zero-shot, Laya's needs_team is unreliable (docs/laya-triage.md).
# LAYA_TRIAGE_TEAM_THRESHOLD=0.8
# Checkpoint shared by the guard and triage: a Hugging Face repo id or a local
# dir (e.g. the output of Laya's fine-tuning script).
# LAYA_MODEL=convaiinnovations/laya
# LAYA_MODEL_SUBFOLDER=multilingual

# Sub-agent model tiers — model ids on the ACTIVE provider (unset = the
# provider's own model). With Ollama Cloud, for example:
# MODEL_TIER_FAST=gpt-oss:20b
# MODEL_TIER_STANDARD=gpt-oss:120b
# MODEL_TIER_STRONG=glm-5.3
