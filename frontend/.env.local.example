# Server-only — used by app/api/copilotkit/[[...route]]/route.ts and
# app/api/backend-config/route.ts. Never fetched from the browser.
#
# Local dev (backend on the same machine as this frontend — the default):
BACKEND_URL=http://localhost:8001
#
# Backend on a different machine on your LAN (e.g. reached over mDNS):
# BACKEND_URL=http://your-backend-host.local:8001

# Forwarded on every /sandbox/* and /games/* proxy request as
# X-Sandbox-Token. Leave unset for local single-machine dev — this app
# fetches the backend's own auto-generated token itself instead (see
# app/api/_sandboxToken.ts), so requests are still gated, just without
# needing this set by hand. Set this explicitly (matching backend/.env's
# SANDBOX_API_TOKEN) once BACKEND_URL above points at a *different* machine
# than this one — auto-discovery only works when frontend and backend share
# a host, since the backend only answers /sandbox/_local-token to a
# localhost caller.
# SANDBOX_API_TOKEN=
