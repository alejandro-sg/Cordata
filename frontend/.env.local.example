# Server-only — used by app/api/copilotkit/[[...route]]/route.ts and
# app/api/backend-config/route.ts. Never fetched from the browser.
#
# Local dev (backend on the same machine as this frontend):
# BACKEND_URL=http://localhost:8001
#
# Mini-hosted deployment (frontend on the mini, backend on the machine
# actually running the oMLX model, reached over the LAN via mDNS):
BACKEND_URL=http://asierra-llm-mbp.local:8001
