#!/usr/bin/env bash
# Blocks a commit that adds a credential. Enable once per clone: `make hooks`. Bypass only knowingly: git commit --no-verify.
root="$(git rev-parse --show-toplevel)"
for kind in release debug; do
  bin="$root/tui/target/$kind/cordata-secrets"
  [[ -x "$bin" ]] && exec "$bin" --staged
done
cd "$root/tui" && exec cargo run -q -p cordata-guard --bin cordata-secrets -- --staged
